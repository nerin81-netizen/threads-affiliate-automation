# 토스 쉐어링크 공식 Open API 설정
TOSS_SHARELINK_ACCESS_KEY=your_access_key
TOSS_SHARELINK_SECRET_KEY=your_secret_key
TOSS_SHARELINK_PUBLISHER_ID=your_publisher_id

# 스레드 계정 정보
THREADS_ID=your_threads_id
THREADS_PW=your_threads_password

# ── 공개 대시보드 관리자 인증 ──
# 운영 서버에서는 반드시 긴 임의 비밀번호를 설정한다. 미설정 시 직접 localhost 접속만 허용된다.
DASHBOARD_ADMIN_PASSWORD=
# 리버스 프록시의 실제 공개 원점. 요청 출처 검증에 사용한다.
DASHBOARD_PUBLIC_ORIGIN=https://your-domain.com

# Meta 공식 Threads Graph API 인증 정보
THREADS_APP_ID=your_meta_app_id
THREADS_APP_SECRET=your_meta_app_secret
THREADS_ACCOUNT_ID=your_account_username
THREADS_ACCESS_TOKEN=your_long_lived_access_token

# ── AI 답글 엔진 (Google Gemini) ──
# Azure Key Vault: kv-hermes-azure / GEMINI-API-KEY
AZURE_KEY_VAULT_NAME=your-key-vault-name
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── AI 장면 이미지 생성 (애니/웹툰 · 유나 캐릭터) ──
# 이미지 생성 모델 (Gemini Image / Nano Banana). 미설정 시 기본값 사용.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── AI 동영상 (선택) ──
# 기본 동영상은 이미지에 모션을 입히는 방식(Ken Burns)으로 추가 비용 없음.
# 아래 VEO_API_KEY를 넣으면 유나가 실제로 움직이는 Veo I2V 영상 사용 가능(유료).
# 비워두면 Veo는 호출되지 않으며 자동으로 모션 방식으로 동작한다.
VEO_API_KEY=
VEO_MODEL=veo-3.0-generate

# ── 검색어 시장조사 (NAVER API HUB) ──
# 비워두면 Key Vault 에서 자동 조회
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# ── Azure Blob Storage ──
# Key Vault: kv-hermes-azure / AZURE-STORAGE-CONNECTION-STRING
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=threads-media

# ── Azure PostgreSQL ──
# 비밀번호는 소스 기본값 없이 운영 환경 또는 Key Vault에서만 주입
PGHOST=your_postgres_host
PGUSER=your_postgres_user
PGDATABASE=your_postgres_database
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require
